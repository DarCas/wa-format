{
  "author": {
    "email": "dario@casertano.name",
    "name": "Dario Casertano (DarCas)",
    "url": "https://casertano.name"
  },
  "bin": {
    "wa-format-mcp": "./dist/esm/mcp/bin.js"
  },
  "bugs": {
    "url": "https://github.com/DarCas/wa-format/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7"
  },
  "description": "Convert WhatsApp formatted text into HTML and back. Supports bold, italic, strikethrough, inline code, code blocks, block quotes and lists. Works in Node.js and the browser, and exposes an MCP server.",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/DarCas/wa-format#readme",
  "keywords": [
    "whatsapp",
    "wa",
    "format",
    "formatter",
    "markdown",
    "html",
    "chat",
    "parser",
    "mcp"
  ],
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "name": "@darcas/wa-format",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DarCas/wa-format.git"
  },
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && node scripts/postbuild.mjs",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:esm": "tsc -p tsconfig.esm.json",
    "clean": "rm -rf dist",
    "deploy": "npm run clean && npm run build && npm publish --access public",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test": "node --test \"./tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "version": "0.5.0"
}
